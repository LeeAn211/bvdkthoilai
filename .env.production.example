# ============================================================
# BVĐK KHU VỰC THỚI LAI - PRODUCTION ENVIRONMENT TEMPLATE
# Không commit file .env thật lên Git.
# ============================================================
NODE_ENV=production

# URL công khai bắt buộc dùng HTTPS
NEXT_PUBLIC_SITE_URL=https://benhvienthoilai.vn

# PostgreSQL. Thay user/password/host/database bằng thông tin thật.
DATABASE_URL=postgresql://postgres:CHANGE_ME@db:5432/thoi_lai_hospital
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# Tối thiểu 32 ký tự, nên dùng chuỗi ngẫu nhiên dài 64+ ký tự.
PAYLOAD_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
PREVIEW_SECRET=CHANGE_ME_WITH_ANOTHER_LONG_RANDOM_SECRET_32_CHARS

# Các tích hợp công khai
NEXT_PUBLIC_MEDPRO_URL=https://medpro.vn/
NEXT_PUBLIC_HOTLINE=
NEXT_PUBLIC_ZALO_URL=

# Tùy chọn
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_ID=

# Chỉ dùng khi seed môi trường mới; không để mật khẩu mặc định.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
